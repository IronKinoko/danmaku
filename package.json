{
  "name": "@ironkinoko/danmaku",
  "version": "2.0.1",
  "description": "Display danmaku (flying comments) on HTML5 video.",
  "main": "dist/danmaku.umd.js",
  "module": "dist/danmaku.mjs",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "types"
  ],
  "types": "dist/index.d.ts",
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "build": "vite build && npm run dts",
    "dts": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "prettier": "prettier --write '{src,types}/**/*'",
    "version": "npm run build",
    "postversion": "git push && git push --tags && npm publish --access public"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IronKinoko/danmaku.git"
  },
  "keywords": [
    "danmaku",
    "comment",
    "弹幕",
    "video",
    "audio",
    "live"
  ],
  "author": "IroKinoko<kinoko_main@outlook.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/IronKinoko/danmaku/issues"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "{src,types,examples}/**/*": [
      "prettier --write"
    ]
  },
  "prettier": {
    "singleQuote": true,
    "semi": false,
    "tabWidth": 2,
    "trailingComma": "es5"
  },
  "browserslist": [
    ">0.5%",
    "not op_mini all",
    "not dead"
  ]
}
